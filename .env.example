# --- Required ---
ADMIN_PASSWORD=changeme
TZ=America/New_York

# --- Optional (auto-generated and persisted on first boot if not set) ---
# JWT_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Optional features ---
# ADMIN_USERNAME=admin
# NEXT_PUBLIC_APP_URL=https://camera.internal
# VAPID_SUBJECT=mailto:you@example.com

# --- Hardware detection (optional) ---
# DETECTOR_TYPE=cpu            # cpu, edgetpu, tensorrt (auto-detected if not set)
# GPU_ENABLED=false
# GPU_VRAM_MB=0
# CORAL_DEVICE=usb             # usb, pci, /dev/apex_0

# --- Advanced (you probably don't need these) ---
# ADMIN_PASSWORD_HASH=         # Pre-hashed password (bypasses ADMIN_PASSWORD)
# FRIGATE_URL=http://frigate:5000
# FRIGATE_INTERNAL_URL=http://frigate:1984
# MQTT_URL=mqtt://mqtt:1883
# DATABASE_URL=file:/app/prisma/data/camera-monitor.db
